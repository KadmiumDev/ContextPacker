<UserControl x:Class="ContextPackerTool.Views.PackerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="400">

    <UserControl.Resources>
        <!-- ================= Kadmium Fonts (Pack URI) ================= -->
        <FontFamily x:Key="KadmiumHeaderFont">Michroma</FontFamily>
        <FontFamily x:Key="KadmiumBodyFont">Inter</FontFamily>

        <!-- ================= Kadmium Theme Brushes ================= -->
        <Color x:Key="KadmiumAccentColor">#5EA3D9</Color>
        <Color x:Key="KadmiumDarkBlue">#2C3947</Color>
        <Color x:Key="KadmiumBlueGray">#546B7D</Color>
        <Color x:Key="KadmiumDeepDark">#090C10</Color>
        <Color x:Key="KadmiumCardBackground">#12161B</Color>
        <Color x:Key="KadmiumBorderColor">#1AFFFFFF</Color>

        <SolidColorBrush x:Key="KadmiumAccentBrush" Color="{StaticResource KadmiumAccentColor}"/>
        <SolidColorBrush x:Key="KadmiumDarkBlueBrush" Color="{StaticResource KadmiumDarkBlue}"/>
        <SolidColorBrush x:Key="KadmiumBlueGrayBrush" Color="{StaticResource KadmiumBlueGray}"/>
        <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource KadmiumDeepDark}"/>
        <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource KadmiumCardBackground}"/>
        <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource KadmiumBorderColor}"/>

        <SolidColorBrush x:Key="KadmiumTextPrimaryBrush" Color="#ECEFF4"/>
        <SolidColorBrush x:Key="KadmiumTextMutedBrush" Color="{StaticResource KadmiumBlueGray}"/>
        <SolidColorBrush x:Key="KadmiumErrorBrush" Color="#C05555"/>

        <!-- ================= Default Controls Styling ================= -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource KadmiumBodyFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource KadmiumTextPrimaryBrush}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource KadmiumBodyFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{StaticResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource KadmiumTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource KadmiumAccentBrush}"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="{StaticResource KadmiumBodyFont}"/>
            <Setter Property="Background" Value="{StaticResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource KadmiumTextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="FontFamily" Value="{StaticResource KadmiumBodyFont}"/>
            <Setter Property="Background" Value="{StaticResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource KadmiumTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardStrokeColorDefaultBrush}"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="FontFamily" Value="{StaticResource KadmiumBodyFont}"/>
            <Setter Property="Foreground" Value="{StaticResource KadmiumTextPrimaryBrush}"/>
        </Style>

        <!-- ================= Specific Kadmium Styles ================= -->
        <Style x:Key="KadmiumPageHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource KadmiumHeaderFont}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource KadmiumAccentBrush}"/>
        </Style>

        <Style x:Key="KadmiumSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource KadmiumHeaderFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource KadmiumAccentBrush}"/>
        </Style>

        <!-- Primary Accent Button -->
        <Style x:Key="KadmiumAccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource KadmiumAccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ApplicationPageBackgroundThemeBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource KadmiumBodyFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7BB6E4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource KadmiumBlueGrayBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Kadmium Button -->
        <Style x:Key="KadmiumButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource KadmiumDarkBlueBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource KadmiumBodyFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource KadmiumAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource KadmiumBlueGrayBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mörk Kadmium ComboBox med custom ToggleButton -->
        <Style x:Key="KadmiumComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource KadmiumTextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Bakgrund och pil -->
                            <ToggleButton x:Name="ToggleButton" 
                                  Focusable="False" 
                                  ClickMode="Press" 
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="TemplateRoot" 
                                        Background="{StaticResource CardBackgroundFillColorDefaultBrush}" 
                                        BorderBrush="{StaticResource CardStrokeColorDefaultBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="4">
                                            <Grid Margin="0,0,8,0">
                                                <!-- Nedåtpil -->
                                                <Path x:Name="Arrow" 
                                              HorizontalAlignment="Right" 
                                              VerticalAlignment="Center" 
                                              Data="M 0 0 L 4 4 L 8 0 Z" 
                                              Fill="{StaticResource KadmiumBlueGrayBrush}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="{StaticResource KadmiumAccentBrush}"/>
                                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource KadmiumAccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="{StaticResource KadmiumAccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Texten för valt element -->
                            <ContentPresenter x:Name="ContentSite" 
                                      IsHitTestVisible="False" 
                                      Content="{TemplateBinding SelectionBoxItem}" 
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                      Margin="10,6,25,6" 
                                      VerticalAlignment="Center" 
                                      HorizontalAlignment="Left"/>

                            <!-- Dropdown Popup -->
                            <Popup x:Name="Popup" 
                           Placement="Bottom" 
                           IsOpen="{TemplateBinding IsDropDownOpen}" 
                           AllowsTransparency="True" 
                           Focusable="False" 
                           PopupAnimation="Slide">
                                <Grid x:Name="DropDown" 
                              MinWidth="{TemplateBinding ActualWidth}" 
                              MaxHeight="{TemplateBinding MaxDropDownHeight}" 
                              SnapsToDevicePixels="True">
                                    <Border x:Name="DropDownBorder" 
                                    Background="{StaticResource CardBackgroundFillColorDefaultBrush}" 
                                    BorderBrush="{StaticResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="4" 
                                    Margin="0,2,0,0">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ApplicationPageBackgroundThemeBrush}">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Text="CONTEXT PACKER" Style="{StaticResource KadmiumPageHeaderStyle}" Margin="0,0,0,12"/>

            <!-- Drag & Drop / Selected Files Zone -->
            <Border Grid.Row="1" 
                    BorderBrush="{StaticResource KadmiumBlueGrayBrush}" 
                    BorderThickness="1" 
                    CornerRadius="4" 
                    AllowDrop="True" 
                    PreviewDragEnter="Border_DragEnter" 
                    PreviewDragOver="Border_DragOver" 
                    PreviewDrop="Border_Drop" 
                    Background="{StaticResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <TextBlock Text="Drag and drop files, folders, or solution items here..." 
                               Foreground="{StaticResource KadmiumTextMutedBrush}"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedFiles.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

     
                    <ListView ItemsSource="{Binding SelectedFiles}" 
                              Background="Transparent" 
                              BorderThickness="0" 
                              IsHitTestVisible="True"
                              AllowDrop="True"
                              Foreground="{StaticResource KadmiumTextPrimaryBrush}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="✕" Foreground="{StaticResource KadmiumErrorBrush}" 
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Click="RemoveFile_Click" Tag="{Binding}" Margin="10,0,4,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Settings & Configuration Form -->
            <StackPanel Grid.Row="2" Margin="0,12,0,12">
                <!-- Format Selector -->
                <TextBlock Text="Output Format:" Foreground="{StaticResource KadmiumTextMutedBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="FormatSelector" 
                          Style="{StaticResource KadmiumComboBoxStyle}" 
                          Margin="0,0,0,8">
                    <ComboBoxItem Content="LLM Tree" IsSelected="True"/>
                    <ComboBoxItem Content="Note Tree"/>
                </ComboBox>

                <!-- Mission Context -->
                <TextBlock Text="Mission Context (Optional):" Foreground="{StaticResource KadmiumTextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="MissionContextInput" TextWrapping="Wrap" AcceptsReturn="True" Height="60" 
                         ToolTip="Write instructions to the AI or summary notes here..." Margin="0,0,0,8" Padding="6"/>

                <TextBlock Text="Base Filename:" Foreground="{StaticResource KadmiumTextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="ContextFileNameInput" Text="Kadmium_Context" Padding="6" Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Clear All" Click="ClearFiles_Click" Style="{StaticResource KadmiumButtonStyle}" Margin="0,0,4,0"/>
                    <Button Grid.Column="1" Content="Load Cache" Click="OpenCache_Click" Style="{StaticResource KadmiumButtonStyle}" Margin="4,0,0,0"/>
                </Grid>

                <Button Content="PACK TO TXT" Click="PackFiles_Click" Style="{StaticResource KadmiumAccentButtonStyle}"/>
            </StackPanel>

            <!-- Packages List -->
            <StackPanel Grid.Row="3">
                <TextBlock Text="PACKAGES" Style="{StaticResource KadmiumSectionHeaderStyle}" Margin="0,0,0,6"/>
                <Border Background="{StaticResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{StaticResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="4">
                    <ListView ItemsSource="{Binding GeneratedFiles}" BorderThickness="0" Background="Transparent"
                              Foreground="{StaticResource KadmiumTextPrimaryBrush}" Height="120">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,2" MouseMove="GeneratedFile_MouseMove" Background="Transparent" Cursor="Hand">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Open File" Click="Menu_OpenFile_Click" Tag="{Binding FullPath}"/>
                                            <MenuItem Header="Open File Location" Click="Menu_GoToFile_Click" Tag="{Binding FullPath}"/>
                                            <Separator/>
                                            <MenuItem Header="Remove File" Click="Menu_RemoveFile_Click" Tag="{Binding}" Foreground="{StaticResource KadmiumErrorBrush}"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <TextBlock Text="{Binding FileName}" Padding="6,4" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>