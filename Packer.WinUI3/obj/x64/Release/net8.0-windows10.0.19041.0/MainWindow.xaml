<Window
    x:Class="Packer.WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Context Packer">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar Grid -->
        <Grid x:ConnectionId='2' x:Name="AppTitleBar" Grid.Row="0" Background="#12161B">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand Logo & Titel -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE943;" Foreground="{ThemeResource KadmiumAccentBrush}" FontSize="13"/>
                <TextBlock Text="CONTEXT PACKER" 
                           FontFamily="{StaticResource KadmiumHeaderFont}"
                           Foreground="{ThemeResource KadmiumAccentBrush}" 
                           FontSize="12" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Settings / Back Knapp -->
            <Button x:ConnectionId='4' x:Name="NavSettingsButton" Grid.Column="2" 
                                             
                    Width="40" Height="32"
                    Background="Transparent" BorderThickness="0"
                    Padding="0" ToolTipService.ToolTip="Settings">
                <FontIcon x:ConnectionId='5' x:Name="SettingsNavIcon" Glyph="&#xE713;" FontSize="12" Foreground="{ThemeResource KadmiumAccentBrush}"/>
            </Button>
        </Grid>

        <!-- Dynamic Content Frame -->
        <Frame x:ConnectionId='3' x:Name="RootFrame" Grid.Row="1"/>
    </Grid>
</Window>

