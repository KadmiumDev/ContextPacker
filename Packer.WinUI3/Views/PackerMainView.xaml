<Page
    x:Class="Packer.WinUI3.Views.PackerMainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- Staging DropZone -->
        <Border Grid.Row="0" BorderBrush="{ThemeResource KadmiumAccentBrush}" 
                BorderThickness="1" CornerRadius="4" Padding="4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop">
            <ListView x:Name="SelectedFilesList">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FileName}" Foreground="White" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="X" Foreground="{ThemeResource KadmiumErrorBrush}" 
                                    Background="Transparent" BorderThickness="0"
                                    Click="RemoveFile_Click" Tag="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Packing Controls -->
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,12,0,12">
            <TextBlock Text="Output Format:" Opacity="0.8" Foreground="White"/>
            <ComboBox x:Name="FormatSelector" HorizontalAlignment="Stretch" SelectedIndex="0">
                <ComboBoxItem Content="LLM Tree"/>
                <ComboBoxItem Content="Note Tree"/>
            </ComboBox>

            <TextBlock Text="Mission Context (Optional):" Opacity="0.8" Foreground="White"/>
            <TextBox x:Name="MissionContextInput" TextWrapping="Wrap" AcceptsReturn="True" Height="65"/>

            <TextBlock Text="Base Filename:" Opacity="0.8" Foreground="White"/>
            <TextBox x:Name="ContextFileNameInput" Text="Kadmium_Context"/>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Clear All" HorizontalAlignment="Stretch" Click="ClearFiles_Click"/>
                <Button Grid.Column="1" Content="Load Cache" HorizontalAlignment="Stretch" Click="OpenCache_Click"/>
            </Grid>

            <Button Content="PACK TO TXT" HorizontalAlignment="Stretch" 
                    Click="PackFiles_Click" Style="{StaticResource KadmiumPrimaryButtonStyle}"/>
        </StackPanel>

        <!-- Generated Output Packages -->
        <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock Text="PACKAGES" Style="{StaticResource KadmiumSectionHeaderStyle}"/>
            <ListView x:Name="GeneratedFilesList"
                      MinHeight="130"
                      CanDragItems="True"
                      DragItemsStarting="GeneratedFilesList_DragItemsStarting"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource KadmiumAccentBrush}"
                      BorderThickness="1" CornerRadius="4" Padding="4">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8,4" Background="Transparent">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Open File" Click="Menu_OpenFile_Click" Tag="{Binding FullPath}"/>
                                    <MenuFlyoutItem Text="Open File Location" Click="Menu_GoToFile_Click" Tag="{Binding FullPath}"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Remove File" Click="Menu_RemoveFile_Click" Tag="{Binding}" Foreground="{ThemeResource KadmiumErrorBrush}"/>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <TextBlock Text="{Binding FileName}" Foreground="White" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>